# Product Idea Agent - Environment Variables
# Copy this file to .env and fill in the values

# Optional: API keys for enhanced data sources
# These are not required for basic functionality but improve data quality

# Google Custom Search API (for enhanced search)
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Reddit API (for enhanced community signals)
# REDDIT_CLIENT_ID=your_reddit_client_id
# REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Note: The skill pack works without any API keys by using
# Claude Code's built-in WebSearch and WebFetch tools.
